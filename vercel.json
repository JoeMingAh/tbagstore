{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "trailingSlash": false,
  "redirects": [
    { "source": "/products/magnetic-golf-towel", "destination": "/products/the-clingy-caddie", "permanent": true },
    { "source": "/towel", "destination": "/products/the-clingy-caddie", "permanent": true }
  ],
  "rewrites": [
    { "source": "/shop", "destination": "/shop/index.html" },
    { "source": "/products/the-first-tee-sack", "destination": "/products/the-first-tee-sack/index.html" },
    { "source": "/products/the-heavy-hitter", "destination": "/products/the-heavy-hitter/index.html" },
    { "source": "/products/the-clingy-caddie", "destination": "/products/the-clingy-caddie/index.html" },
    { "source": "/products/the-sandbaggers-stash", "destination": "/products/the-sandbaggers-stash/index.html" },
    { "source": "/products/the-crown-jewel", "destination": "/products/the-crown-jewel/index.html" },
    { "source": "/products/the-yardage-alibi", "destination": "/products/the-yardage-alibi/index.html" },
    { "source": "/products/the-gentlemans-timber", "destination": "/products/the-gentlemans-timber/index.html" },
    { "source": "/products/the-back-nine-flask-valet-pouch", "destination": "/products/the-back-nine-flask-valet-pouch/index.html" },
    { "source": "/about", "destination": "/about/index.html" },
    { "source": "/club", "destination": "/club/index.html" },
    { "source": "/faq", "destination": "/faq/index.html" },
    { "source": "/shipping", "destination": "/shipping/index.html" },
    { "source": "/returns", "destination": "/returns/index.html" },
    { "source": "/privacy", "destination": "/privacy/index.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ]
}
