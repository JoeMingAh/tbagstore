# Copy to .env.local for local dev. Never commit real values.

# Canonical site origin used for robots.txt, sitemap.xml, canonical and Open Graph URLs.
SITE_URL=https://www.tbagstore.com

# Email signup provider for /api/subscribe. Set to "resend" to store signups in Resend;
# anything else (or unset) only logs a stub line.
SUBSCRIBE_PROVIDER=

# Required when SUBSCRIBE_PROVIDER=resend. If either is missing the API falls back to the stub.
RESEND_API_KEY=
RESEND_AUDIENCE_ID=
