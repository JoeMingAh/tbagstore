# Copy to .env.local for local dev. Never commit real values.

# Canonical site origin used for robots.txt, sitemap.xml, canonical and Open Graph URLs.
SITE_URL=https://www.tbagstore.com

# Optional override for /api/subscribe: "stub" only logs, even if a Resend key is set.
SUBSCRIBE_PROVIDER=

# When RESEND_API_KEY is set, signups become Resend contacts tagged brand=RESEND_BRAND.
# Set SUBSCRIBE_PROVIDER=stub to force the stub. RESEND_SEGMENT_ID is optional.
RESEND_API_KEY=
RESEND_BRAND=tbagstore
RESEND_SEGMENT_ID=
